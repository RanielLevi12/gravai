# Copie para worker/.env na VPS e preencha. Nunca vai para o git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# O mesmo valor do app.
WORKER_SECRET=
# Endereço público do app (para pedir a transcrição).
APP_URL=
# Cloudflare R2 (armazenamento de vídeos).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcional: 0 (padrão) = nunca sai.
WORKER_IDLE_EXIT_MS=
