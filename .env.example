# Só no servidor. Nunca use prefixo NEXT_PUBLIC_ para chaves.
TYPESAFE_API_KEY=
# 32 bytes em base64 (ex.: openssl rand -base64 32). Cifra a chave OpenRouter de cada usuário.
AI_KEY_ENCRYPTION_SECRET=
# Chave OpenRouter DO GRAVAÍ: é a IA padrão de quem não conectou conta própria. Só no servidor; nunca no Git.
OPENROUTER_API_KEY=
# Limite mensal por usuário na IA do Gravaí, em dólares (padrão 3). Exige a migração 0015.
AI_MONTHLY_LIMIT_USD=
# Só para scripts/ai-smoke.ts. O app nunca lê esta variável (usa a chave do OAuth de cada usuário).
OPENROUTER_DEV_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare R2 (armazenamento de vídeos). Só no servidor.
R2_ACCOUNT_ID=
R2_BUCKET=gravai-videos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
