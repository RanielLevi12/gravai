  "components": [
    {
      "name": "Botão primário",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A única ação principal da tela, no rodapé.",
      "html": "<button class=\"ds-btn-primary\">Próxima<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-btn-primary{font-family:'Hanken Grotesk',system-ui,sans-serif;display:flex;align-items:center;justify-content:center;gap:10px;width:320px;min-height:56px;padding:0 22px;border:0;border-radius:16px;background:#E11D55;color:#fff;font-size:17px;font-weight:700;cursor:pointer;box-shadow:0 4px 10px rgba(225,29,85,.28),0 12px 28px rgba(225,29,85,.18);transition:transform .18s cubic-bezier(.16,1,.3,1),background-color .18s cubic-bezier(.16,1,.3,1);}.ds-btn-primary:hover{background:#C3134A;}.ds-btn-primary:active{transform:scale(.98);}.ds-btn-primary:focus-visible{outline:3px solid #1E9BFF;outline-offset:2px;}"
    },
    {
      "name": "Botão suave",
      "kind": "button",
      "refersTo": "button-soft",
      "description": "Ação secundária de largura total.",
      "html": "<button class=\"ds-btn-soft\">Baixar tudo (.zip)</button>",
      "css": ".ds-btn-soft{font-family:'Hanken Grotesk',system-ui,sans-serif;display:flex;align-items:center;justify-content:center;gap:10px;width:320px;min-height:56px;padding:0 22px;border:0;border-radius:16px;background:#F4F5F9;color:#15161C;font-size:17px;font-weight:700;cursor:pointer;transition:transform .18s cubic-bezier(.16,1,.3,1),background-color .18s cubic-bezier(.16,1,.3,1);}.ds-btn-soft:hover{background:#ECEEF4;}.ds-btn-soft:active{transform:scale(.98);}.ds-btn-soft:focus-visible{outline:3px solid #1E9BFF;outline-offset:2px;}"
    },
    {
      "name": "Botão de próxima ação",
      "kind": "button",
      "refersTo": "button-next",
      "description": "Próximo passo dentro do card de projeto.",
      "html": "<button class=\"ds-btn-next\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5\"/><rect x=\"2\" y=\"6\" width=\"14\" height=\"12\" rx=\"2\"/></svg>Gravar</button>",
      "css": ".ds-btn-next{font-family:'Hanken Grotesk',system-ui,sans-serif;display:inline-flex;align-items:center;gap:6px;height:38px;padding:0 14px;border:0;border-radius:12px;background:#15161C;color:#fff;font-size:14.5px;font-weight:700;cursor:pointer;transition:transform .18s cubic-bezier(.16,1,.3,1);}.ds-btn-next svg{width:17px;height:17px;}.ds-btn-next:active{transform:scale(.98);}.ds-btn-next:focus-visible{outline:3px solid #1E9BFF;outline-offset:2px;}"
    },
    {
      "name": "Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Informação compacta; 'Salvo' em menta.",
      "html": "<div class=\"ds-chips\"><span class=\"ds-chip\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"10\" x2=\"14\" y1=\"2\" y2=\"2\"/><line x1=\"12\" x2=\"15\" y1=\"14\" y2=\"11\"/><circle cx=\"12\" cy=\"14\" r=\"8\"/></svg>3:05</span><span class=\"ds-chip\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"6\" cy=\"6\" r=\"3\"/><path d=\"M8.12 8.12 12 12\"/><path d=\"M20 4 8.12 15.88\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><path d=\"M14.8 14.8 20 20\"/></svg>5 cortes</span><span class=\"ds-chip ds-chip-saved\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg>Salvo</span></div>",
      "css": ".ds-chips{display:flex;gap:6px;}.ds-chip{font-family:'Hanken Grotesk',system-ui,sans-serif;display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border-radius:999px;background:#F4F5F9;color:#555867;font-size:13px;font-weight:600;font-variant-numeric:tabular-nums;}.ds-chip svg{width:15px;height:15px;}.ds-chip-saved{background:#DDF6EA;color:#08643A;}"
    },
    {
      "name": "Opção sugerida",
      "kind": "custom",
      "refersTo": "option-card-selected",
      "description": "Opção da entrevista já marcada pela IA, com selo Sugerido e barras de corte.",
      "html": "<button class=\"ds-opt\" role=\"radio\" aria-checked=\"true\"><span class=\"ds-opt-check\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg></span><div class=\"ds-opt-big\">30<small>s</small></div><div class=\"ds-opt-sub\">≈ 5 cortes</div><div class=\"ds-opt-cuts\"><i></i><i></i><i></i><i></i><i></i></div><span class=\"ds-badge\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z\"/></svg>Sugerido</span></button>",
      "css": ".ds-opt{font-family:'Hanken Grotesk',system-ui,sans-serif;position:relative;width:170px;text-align:left;padding:18px 16px 16px;border-radius:16px;background:#FFE4EC;border:2px solid #E11D55;color:#15161C;cursor:pointer;transition:border-color .2s cubic-bezier(.16,1,.3,1),background-color .2s cubic-bezier(.16,1,.3,1);}.ds-opt:focus-visible{outline:3px solid #1E9BFF;outline-offset:2px;}.ds-opt-check{position:absolute;top:12px;right:12px;width:26px;height:26px;border-radius:50%;background:#E11D55;color:#fff;display:grid;place-items:center;}.ds-opt-check svg{width:16px;height:16px;}.ds-opt-big{font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:800;font-size:34px;letter-spacing:-0.03em;line-height:1;font-variant-numeric:tabular-nums;}.ds-opt-big small{font-size:18px;letter-spacing:0;margin-left:2px;}.ds-opt-sub{margin-top:8px;font-size:14px;color:#555867;font-variant-numeric:tabular-nums;}.ds-opt-cuts{display:flex;gap:3px;margin-top:10px;height:8px;}.ds-opt-cuts i{flex:1;border-radius:2px;}.ds-opt-cuts i:nth-child(4n+1){background:#FF7A00;}.ds-opt-cuts i:nth-child(4n+2){background:#1E9BFF;}.ds-opt-cuts i:nth-child(4n+3){background:#12B76A;}.ds-opt-cuts i:nth-child(4n+4){background:#FFC21A;}.ds-badge{display:inline-flex;align-items:center;gap:4px;margin-top:10px;height:24px;padding:0 8px;border-radius:999px;background:#15161C;color:#fff;font-size:12px;font-weight:700;}.ds-badge svg{width:13px;height:13px;}"
    },
    {
      "name": "Bloco de corte",
      "kind": "card",
      "refersTo": "block-cut",
      "description": "Bloco do script que vira corte: borda e etiqueta na cor do corte, texto em tinta.",
      "html": "<section class=\"ds-block\"><div class=\"ds-block-head\"><span class=\"ds-tag\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"6\" cy=\"6\" r=\"3\"/><path d=\"M8.12 8.12 12 12\"/><path d=\"M20 4 8.12 15.88\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><path d=\"M14.8 14.8 20 20\"/></svg>Corte 1</span><span class=\"ds-dur\">0:28</span></div><p>Todo hábito tem três partes: a deixa, a rotina e a recompensa.</p></section>",
      "css": ".ds-block{font-family:'Hanken Grotesk',system-ui,sans-serif;width:340px;border-radius:16px;padding:14px 16px 12px;background:#fff;border:2px solid #FF7A00;box-shadow:0 1px 2px rgba(21,22,28,.06),0 4px 12px rgba(21,22,28,.06);color:#15161C;}.ds-block-head{display:flex;align-items:center;justify-content:space-between;}.ds-tag{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:8px;background:#FF7A00;color:#15161C;font-size:13px;font-weight:700;}.ds-tag svg{width:14px;height:14px;}.ds-dur{font-size:13.5px;font-weight:600;color:#555867;font-variant-numeric:tabular-nums;}.ds-block p{margin:10px 0 0;font-size:16px;line-height:1.55;}"
    },
    {
      "name": "Plataformas",
      "kind": "chip",
      "refersTo": "platform-toggle",
      "description": "Alternância de plataforma, neutra; selecionada em tinta.",
      "html": "<div class=\"ds-plats\"><button class=\"ds-plat\" aria-pressed=\"true\">Reels</button><button class=\"ds-plat\" aria-pressed=\"false\">TikTok</button><button class=\"ds-plat\" aria-pressed=\"false\">YouTube</button></div>",
      "css": ".ds-plats{display:flex;gap:8px;}.ds-plat{font-family:'Hanken Grotesk',system-ui,sans-serif;height:36px;padding:0 14px;border-radius:999px;border:1.5px solid #E3E5EC;background:#fff;color:#15161C;font-size:14px;font-weight:600;cursor:pointer;transition:border-color .2s cubic-bezier(.16,1,.3,1),background-color .2s cubic-bezier(.16,1,.3,1);}.ds-plat:hover{border-color:#C9CCD8;}.ds-plat[aria-pressed=\"true\"]{background:#15161C;border-color:#15161C;color:#fff;}.ds-plat:focus-visible{outline:3px solid #1E9BFF;outline-offset:2px;}"
    },
    {
      "name": "Capas",
      "kind": "custom",
      "refersTo": "cover-poster",
      "description": "Capa existente em linguagem de pôster; antes disso, placeholder tracejado com ícone da origem.",
